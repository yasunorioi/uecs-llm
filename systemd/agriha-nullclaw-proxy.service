[Unit]
Description=NullClaw OpenAI-Compatible Proxy
After=network.target

[Service]
Type=simple
User=agriha
ExecStart=__REPO_DIR__/.venv/bin/uvicorn agriha.control.nullclaw_proxy:app --host 127.0.0.1 --port 3001
WorkingDirectory=__REPO_DIR__
Restart=always
RestartSec=5
EnvironmentFile=__REPO_DIR__/.env

[Install]
WantedBy=multi-user.target
